#!/usr/bin/env bash
set -euo pipefail

SWITCHES="172.20.20.11 172.20.20.12 172.20.20.13"
PASSWORD='NokiaSrl1!'

COMMANDS='enter candidate
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/3 admin-state enable
set / interface ethernet-1/4 admin-state enable
commit save
quit
'

wait_for_ssh() {
    for _ in $(seq 90); do
        nc -z -w1 "$1" 22 >/dev/null 2>&1 && return 0
        sleep 5
    done
    return 1
}

enable_interfaces() {
    printf '%s' "$COMMANDS" | sshpass -p "$PASSWORD" ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        "admin@$1" 2>&1
}

for ip in $SWITCHES; do
    if ! wait_for_ssh "$ip"; then
        echo "$ip: SSH не поднялся" >&2
        exit 1
    fi

    done_for_switch=""
    for _ in $(seq 12); do
        if out=$(enable_interfaces "$ip"); then
            case "$out" in
                *"already in progress"*|*"timeout"*) ;;
                *) done_for_switch=yes; break ;;
            esac
        fi
        sleep 10
    done

    if [ -z "$done_for_switch" ]; then
        echo "$ip: интерфейсы включить не удалось" >&2
        exit 1
    fi
    echo "$ip: интерфейсы включены"
done
